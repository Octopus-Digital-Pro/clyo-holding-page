---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroMedia = {
  imageSrc: "/hero-image.webp",
  imageAlt: "A serene resort pool lined with palm trees at sunset.",
  videoSrc: "",
  cloudflareVideoId: "a1d51085c50b044980ae539cddd5b3c6",
};
const cloudflareHlsSrc = heroMedia.cloudflareVideoId
  ? `https://customer-5qovdqpvicf6gt5l.cloudflarestream.com/${heroMedia.cloudflareVideoId}/manifest/video.m3u8`
  : "";

const inputClasses =
  "h-[42px] w-full rounded-[6px] border border-[var(--color-ivory)] bg-transparent px-[14px] py-[10px] font-[var(--font-serif)] text-[14px] leading-[18px] text-[var(--color-night)] outline-none placeholder:text-(--color-cloud-white)/80 focus:border-[var(--color-sky-blue)] aria-[invalid=true]:border-[var(--destructive)] aria-[invalid=true]:focus:shadow-[0_0_0_3px_oklch(0.577_0.245_27.325_/_0.2)]";
const checkboxClasses =
  " h-[14px] w-[14px] shrink-0 rounded-[2px] border border-[var(--color-ivory)] bg-transparent focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-cloud-white)] aria-[invalid=true]:outline aria-[invalid=true]:outline-1 aria-[invalid=true]:outline-[var(--destructive)] aria-[invalid=true]:outline-offset-1";
const errorClasses =
  "mt-[6px] hidden font-[var(--font-sans)] text-[12px] leading-[16px] text-[var(--destructive)] not-empty:block";
const checkboxRowClasses =
  "flex items-center justify-center gap-[10px] font-[var(--font-serif)] text-[14px] leading-[18px] data-[invalid=true]:text-[var(--destructive)] [&_a]:underline";
const submitButtonClasses =
  "inline-flex w-fit items-center justify-center bg-transparent py-[10px] font-[var(--font-sans)] text-[12px] font-medium uppercase tracking-[1px] leading-[16px] text-[var(--color-night)] transition hover:opacity-70 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-ivory)] xl:text-[14px] xl:leading-[18px] hover:cursor-pointer";
---

<BaseLayout
  title="CLYO Hotels & Resorts"
  description="CLYO Hotels & Resorts is coming soon. Join the list to be the first to hear when our doors open."
  noindex
>
  <main>
    <section class="h-screen w-full" aria-label="Hero image">
      <div
        class="relative h-screen w-full overflow-hidden bg-(--color-cloud-white)"
      >
        {
          heroMedia.cloudflareVideoId ? (
            <div class="relative h-full w-full">
              <img
                class="block h-full w-full object-cover object-center transition-opacity duration-500"
                data-hero-fallback
                src={heroMedia.imageSrc}
                alt={heroMedia.imageAlt}
                loading="eager"
              />
              <video
                class="absolute inset-0 block h-full w-full object-cover object-center opacity-0 transition-opacity duration-500"
                data-hero-video
                data-cloudflare-video
                data-cloudflare-src={cloudflareHlsSrc}
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                poster={heroMedia.imageSrc}
                crossorigin="anonymous"
                aria-label={heroMedia.imageAlt}
              />
            </div>
          ) : heroMedia.videoSrc ? (
            <div class="relative h-full w-full">
              <img
                class="block h-full w-full object-cover object-center transition-opacity duration-500"
                data-hero-fallback
                src={heroMedia.imageSrc}
                alt={heroMedia.imageAlt}
                loading="eager"
              />
              <video
                class="absolute inset-0 block h-full w-full object-cover object-center opacity-0 transition-opacity duration-500"
                data-hero-video
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                poster={heroMedia.imageSrc}
                aria-label={heroMedia.imageAlt}
              >
                <source src={heroMedia.videoSrc} type="video/mp4" />
              </video>
            </div>
          ) : (
            <img
              class="block h-full w-full object-cover object-center"
              src={heroMedia.imageSrc}
              alt={heroMedia.imageAlt}
              loading="eager"
            />
          )
        }
        <div
          class="absolute inset-0 z-10 bg-[linear-gradient(to_bottom,rgba(16,24,32,0.396)_0%,rgba(16,24,32,0.495)_25%,rgba(16,24,32,0.495)_75%,rgba(16,24,32,0.396)_100%)]"
          aria-hidden="true"
        >
        </div>

        <div
          class="absolute inset-0 z-20 h-full w-full px-4 py-6 text-(--color-cloud-white) md:py-8 xl:py-10"
        >
          <p
            class="absolute left-4 top-4 z-30 hidden max-w-[min(90%,600px)] font-[var(--font-sans)] text-[24px] font-bold uppercase leading-[1.3] text-[#ff2d2d]"
            data-autoplay-debug
            role="alert"
          >
          </p>
          <div
            class="absolute inset-0 flex items-center justify-center px-4 text-center"
          >
          </div>

          <div
            class="absolute left-1/2 bottom-8 z-10 hidden w-[calc(100%-2rem)] max-w-[348px] -translate-x-1/2 opacity-0 transition-opacity duration-500"
            data-signup-form-wrapper
          >
            <form class="grid gap-4" id="contact-form" novalidate>
              <div class="grid gap-4">
                <label class="block">
                  <span
                    class="absolute -m-px h-px w-px overflow-hidden whitespace-nowrap border-0 p-0 [clip:rect(0,0,0,0)]"
                  >
                    Email Address
                  </span>
                  <input
                    id="emailAddress"
                    class={inputClasses}
                    type="email"
                    name="emailAddress"
                    placeholder="Email address*"
                    required
                  />
                  <p
                    class={errorClasses}
                    data-error-for="emailAddress"
                    aria-live="polite"
                  >
                  </p>
                </label>
              </div>

              <fieldset class="grid gap-[14px] border-0 p-0 m-0">
                <legend
                  class="absolute -m-px h-px w-px overflow-hidden whitespace-nowrap border-0 p-0 [clip:rect(0,0,0,0)]"
                >
                  Consent
                </legend>
                <label
                  class={checkboxRowClasses}
                  data-checkbox-row
                  data-invalid="false"
                >
                  <input
                    id="privacyConsent"
                    class={checkboxClasses}
                    data-consent-checkbox
                    type="checkbox"
                    name="privacyConsent"
                    required
                  />
                  <span>
                    I agree to receive emails from CLYO. See
                    <a
                      class="underline"
                      href="/privacy-policy"
                      rel="noopener noreferrer"
                    >
                      Privacy Policy
                    </a>
                    .
                  </span>
                </label>
                <p
                  class="mt-[-6px] hidden font-(--font-sans) text-[12px] leading-[16px] text-(--destructive) not-empty:block"
                  data-error-for="privacyConsent"
                  aria-live="polite"
                >
                </p>
              </fieldset>

              <div class="flex justify-center">
                <button class={submitButtonClasses} type="submit">
                  <span>Stay tuned</span>
                </button>
              </div>
              <p
                class="hidden text-center font-(--font-sans) text-[12px] leading-[16px]"
                data-submit-status
                aria-live="polite"
              >
              </p>
            </form>
          </div>

          <div
            class="absolute left-1/2 bottom-12 z-10 flex w-[calc(100%-2rem)] max-w-[348px] -translate-x-1/2 justify-center"
            data-signup-trigger-wrapper
          >
            <button
              class={submitButtonClasses}
              type="button"
              data-signup-trigger
              aria-controls="contact-form"
              aria-expanded="false"
            >
              <span>Stay tuned</span>
            </button>
          </div>
          {
            (heroMedia.cloudflareVideoId || heroMedia.videoSrc) && (
              <button
                type="button"
                class="absolute bottom-8 right-5  z-30 hover:cursor-pointer inline-flex h-12 w-12 items-center justify-center"
                data-video-mute-toggle
                aria-label="Unmute video"
                aria-pressed="true"
              >
                <img
                  src="/mute.svg"
                  alt=""
                  aria-hidden="true"
                  class="h-9 w-9"
                  data-video-mute-icon
                />
              </button>
            )
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const hlsScriptUrl =
    "https://cdn.jsdelivr.net/npm/hls.js@1.5.20/dist/hls.min.js";

  // Diagnostic notice proving an autoplay failure came from the browser's
  // policy (NotAllowedError), not the page. Gated behind ?autoplay-debug so
  // real visitors never see it — share clyo.com/?autoplay-debug to reproduce.
  const autoplayDebugEnabled = new URLSearchParams(window.location.search).has(
    "autoplay-debug",
  );

  const showAutoplayBlockedNotice = (error: DOMException) => {
    if (!autoplayDebugEnabled) {
      return;
    }
    const notice = document.querySelector("[data-autoplay-debug]");
    if (
      !(notice instanceof HTMLElement) ||
      !notice.classList.contains("hidden")
    ) {
      return;
    }
    notice.textContent = `Autoplay blocked by this browser/device (${error.name})`;
    notice.classList.remove("hidden");

    // If playback later starts (e.g. the user taps the native play button),
    // the notice would be stale — remove it.
    const heroVideo = document.querySelector("[data-hero-video]");
    if (heroVideo instanceof HTMLVideoElement) {
      heroVideo.addEventListener(
        "playing",
        () => notice.classList.add("hidden"),
        { once: true },
      );
    }
  };

  const playHeroVideo = (video: HTMLVideoElement) => {
    const playAttempt = video.play();
    if (playAttempt instanceof Promise) {
      playAttempt.catch((error) => {
        console.warn("Hero video playback was blocked.", error);
        if (error instanceof DOMException && error.name === "NotAllowedError") {
          showAutoplayBlockedNotice(error);
        }
      });
    }
  };

  const initHeroVideoLoop = () => {
    const heroVideo = document.querySelector("[data-hero-video]");
    if (!(heroVideo instanceof HTMLVideoElement)) {
      return;
    }

    heroVideo.loop = true;

    const restartPlayback = () => {
      try {
        if (heroVideo.currentTime > 0) {
          heroVideo.currentTime = 0;
        }
      } catch (error) {
        console.warn("Hero video could not rewind.", error);
      }
      playHeroVideo(heroVideo);
    };

    heroVideo.addEventListener("ended", restartPlayback);

    // Streamed playback can stop on the final fragment without firing "ended",
    // which leaves the native loop with nothing to react to.
    const restartIfStuckAtEnd = () => {
      window.setTimeout(() => {
        const nearEnd =
          Number.isFinite(heroVideo.duration) &&
          heroVideo.duration - heroVideo.currentTime < 1;
        const stuck =
          heroVideo.paused ||
          heroVideo.ended ||
          heroVideo.readyState < HTMLMediaElement.HAVE_FUTURE_DATA;
        if (nearEnd && stuck) {
          restartPlayback();
        }
      }, 1000);
    };

    heroVideo.addEventListener("pause", restartIfStuckAtEnd);
    heroVideo.addEventListener("waiting", restartIfStuckAtEnd);
    heroVideo.addEventListener("stalled", restartIfStuckAtEnd);
  };

  // Both playback paths otherwise open the hero on a low rendition and ramp up
  // over the first several segments, which is most of the time anyone spends
  // looking at a 40s loop. Only skip the high-quality start when the
  // connection reports that it cannot sustain ~5 Mbps.
  const shouldPreferHighQuality = () => {
    const connection = (
      navigator as Navigator & {
        connection?: {
          effectiveType?: string;
          downlink?: number;
          saveData?: boolean;
        };
      }
    ).connection;

    // Safari and Firefox do not expose the Network Information API.
    if (!connection) {
      return true;
    }

    if (connection.saveData) {
      return false;
    }

    if (connection.effectiveType && connection.effectiveType !== "4g") {
      return false;
    }

    if (typeof connection.downlink === "number" && connection.downlink < 5) {
      return false;
    }

    return true;
  };

  // Cloudflare Stream trims the manifest to the single rendition that fits the
  // hinted downlink. That removes adaptation, so it is only used on the native
  // HLS path, where the page cannot influence rendition choice any other way.
  const withBandwidthHint = (src: string, hintMbps: number) => {
    try {
      const url = new URL(src, window.location.href);
      url.searchParams.set("clientBandwidthHint", String(hintMbps));
      return url.toString();
    } catch {
      return src;
    }
  };

  const initHeroVideoReveal = () => {
    const heroVideo = document.querySelector("[data-hero-video]");
    const heroFallback = document.querySelector("[data-hero-fallback]");
    if (
      !(heroVideo instanceof HTMLVideoElement) ||
      !(heroFallback instanceof HTMLImageElement)
    ) {
      return;
    }

    let revealed = false;
    let hideFallbackTimeout: number | undefined;

    const revealVideo = () => {
      if (revealed) {
        return;
      }
      revealed = true;
      heroVideo.classList.remove("opacity-0");
      // Keep the fallback image fully visible until the video has finished
      // fading in on top of it. Fading both layers at once leaves a moment
      // where the page background bleeds through, which reads as a flash.
      hideFallbackTimeout = window.setTimeout(() => {
        heroFallback.classList.add("opacity-0");
        heroFallback.setAttribute("aria-hidden", "true");
      }, 600);
    };

    // Reveal only once frames are actually advancing. loadeddata/canplay fire
    // before autoplay starts, which swapped in a frozen first frame that then
    // visibly jumped when playback began.
    if (
      !heroVideo.paused &&
      heroVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA
    ) {
      revealVideo();
    }

    // Not { once: true }: playback can drop out and recover, and the hero has
    // to fade back in when it does.
    heroVideo.addEventListener("playing", revealVideo);

    heroVideo.addEventListener("error", () => {
      revealed = false;
      window.clearTimeout(hideFallbackTimeout);
      heroVideo.classList.add("opacity-0");
      heroFallback.classList.remove("opacity-0");
      heroFallback.removeAttribute("aria-hidden");
    });
  };

  const initHeroVideoAudioControl = () => {
    const heroVideo = document.querySelector("[data-hero-video]");
    const muteToggle = document.querySelector("[data-video-mute-toggle]");
    const muteIcon = document.querySelector("[data-video-mute-icon]");
    if (
      !(heroVideo instanceof HTMLVideoElement) ||
      !(muteToggle instanceof HTMLButtonElement) ||
      !(muteIcon instanceof HTMLImageElement)
    ) {
      return;
    }

    heroVideo.muted = true;
    heroVideo.volume = 1;

    const updateMuteButton = () => {
      const isMuted = heroVideo.muted || heroVideo.volume === 0;
      muteToggle.setAttribute("aria-pressed", String(isMuted));
      muteToggle.setAttribute(
        "aria-label",
        isMuted ? "Unmute video" : "Mute video",
      );
      muteToggle.classList.toggle("opacity-70", isMuted);
      muteIcon.src = isMuted ? "/mute.svg" : "/sound-on.svg";
    };

    heroVideo.addEventListener("volumechange", updateMuteButton);

    muteToggle.addEventListener("click", () => {
      const shouldMute = !(heroVideo.muted || heroVideo.volume === 0);
      heroVideo.muted = shouldMute;
      if (!shouldMute && heroVideo.volume === 0) {
        heroVideo.volume = 1;
      }
      updateMuteButton();
    });

    updateMuteButton();
  };

  const loadHlsScript = () => {
    const existingHls = (window as Window & { Hls?: unknown }).Hls;
    if (existingHls) {
      return Promise.resolve();
    }

    return new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = hlsScriptUrl;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("Failed to load HLS runtime."));
      document.head.append(script);
    });
  };

  const initCloudflareHeroVideo = async () => {
    const cloudflareVideo = document.querySelector("[data-cloudflare-video]");
    if (!(cloudflareVideo instanceof HTMLVideoElement)) {
      return;
    }

    const hlsSrc = cloudflareVideo.dataset.cloudflareSrc;
    if (!hlsSrc) {
      return;
    }

    const preferHighQuality = shouldPreferHighQuality();

    const tryPlay = () => playHeroVideo(cloudflareVideo);

    cloudflareVideo.muted = true;
    cloudflareVideo.volume = 1;

    const playNativeHls = () => {
      cloudflareVideo.src = preferHighQuality
        ? withBandwidthHint(hlsSrc, 5)
        : hlsSrc;
      cloudflareVideo.addEventListener("loadedmetadata", tryPlay, {
        once: true,
      });
      // The loadedmetadata attempt can be rejected while the pipeline is still
      // warming up; retry once the browser reports it can actually play.
      cloudflareVideo.addEventListener("canplay", tryPlay, { once: true });
      cloudflareVideo.load();
    };

    // Chrome answers "maybe" to canPlayType("application/vnd.apple.mpegurl")
    // and will happily play the manifest through its own HLS pipeline — but
    // that pipeline dies with DEMUXER_ERROR_COULD_NOT_PARSE the moment the
    // loop seeks back to 0, which left the hero stuck on its fallback image.
    // hls.js loops correctly, so it handles playback wherever MediaSource
    // exists. Native playback stays for iPhone Safari, which has no MSE and
    // loops HLS without complaint.
    if (!("MediaSource" in window)) {
      playNativeHls();
      return;
    }

    try {
      await loadHlsScript();

      const HlsCtor = (
        window as Window & {
          Hls?: {
            isSupported: () => boolean;
            Events: { MANIFEST_PARSED: string; ERROR: string };
            ErrorTypes: { MEDIA_ERROR: string; NETWORK_ERROR: string };
            new (config?: Record<string, unknown>): {
              levels: { height?: number; bitrate?: number }[];
              startLevel: number;
              loadSource: (src: string) => void;
              attachMedia: (media: HTMLMediaElement) => void;
              startLoad: () => void;
              recoverMediaError: () => void;
              destroy: () => void;
              on: (
                event: string,
                handler: (
                  event: string,
                  data: { fatal?: boolean; type?: string; details?: string },
                ) => void,
              ) => void;
            };
          };
        }
      ).Hls;

      if (HlsCtor && HlsCtor.isSupported()) {
        type HlsInstance = InstanceType<NonNullable<typeof HlsCtor>>;

        let hls: HlsInstance | null = null;
        let playedSincePlayerBuild = true;

        const buildPlayer = () => {
          const player = new HlsCtor({
            // The hero fills the viewport, so never let hls.js cap the
            // rendition to the element's CSS box.
            capLevelToPlayerSize: false,
            // Default is 500 kbps, which opens the hero on the 240p rendition.
            // The 1080p rung peaks at ~6.8 Mbps, so the estimate has to clear
            // that for ABR to pick it on the very first fragment.
            abrEwmaDefaultEstimate: preferHighQuality ? 8_000_000 : 1_500_000,
            // Buffer the whole loop where the connection allows, so the second
            // and later passes play from cache at full quality.
            maxBufferLength: 45,
            maxMaxBufferLength: 60,
            // Ask to keep what has already played. Chrome evicts it anyway
            // under memory pressure, which is what rebuildPlayer() cleans up
            // after, but on the runs where it holds the loop is seamless.
            backBufferLength: Infinity,
          });

          // Open on the highest rendition instead of ramping up through the
          // ladder. ABR still steps down if the connection cannot sustain it.
          if (preferHighQuality) {
            player.on(HlsCtor.Events.MANIFEST_PARSED, () => {
              const best = player.levels.reduce((bestIndex, level, index) => {
                const current = player.levels[bestIndex];
                const isBetter =
                  (level.height ?? 0) > (current.height ?? 0) ||
                  ((level.height ?? 0) === (current.height ?? 0) &&
                    (level.bitrate ?? 0) > (current.bitrate ?? 0));
                return isBetter ? index : bestIndex;
              }, 0);
              player.startLevel = best;
            });
          }

          player.on(HlsCtor.Events.ERROR, (_event, data) => {
            if (!data.fatal) {
              return;
            }

            if (data.type === HlsCtor.ErrorTypes.NETWORK_ERROR) {
              console.warn(
                "Cloudflare hero video hit a network error, reloading.",
                data.details,
              );
              player.startLoad();
              return;
            }

            console.warn(
              "Cloudflare hero video hit a fatal player error.",
              data.details,
            );
            rebuildPlayer();
          });

          player.loadSource(hlsSrc);
          player.attachMedia(cloudflareVideo);
          hls = player;
        };

        // Chrome evicts the part of the clip that has already played, so when
        // the loop seeks back to 0 the player has to re-append the opening
        // segment into an already-ended MediaSource. Chrome rejects that with
        // DEMUXER_ERROR_COULD_NOT_PARSE and playback is dead for good, leaving
        // the hero on its fallback image. hls.js reports nothing in that case,
        // so watch the media element itself; rebuilding the player is the only
        // reliable way back into the loop.
        const rebuildPlayer = () => {
          if (!playedSincePlayerBuild) {
            // The last rebuild never reached playback, so stop rather than
            // hammer the CDN behind a hero nobody can see.
            console.warn("Cloudflare hero video could not be recovered.");
            return;
          }

          playedSincePlayerBuild = false;
          const previous = hls;
          hls = null;
          previous?.destroy();
          // Tearing the old player down empties the element's src, which fires
          // one more error; build the replacement once that has settled.
          window.setTimeout(buildPlayer, 0);
        };

        cloudflareVideo.addEventListener("playing", () => {
          playedSincePlayerBuild = true;
        });

        cloudflareVideo.addEventListener("error", () => {
          const mediaError = cloudflareVideo.error;
          // Raised by the teardown in rebuildPlayer(), not by playback.
          if (!mediaError || /empty src/i.test(mediaError.message)) {
            return;
          }

          console.warn(
            "Cloudflare hero video pipeline failed, rebuilding.",
            mediaError.message,
          );
          rebuildPlayer();
        });

        // Not { once: true }: a rebuilt player has to be started again.
        cloudflareVideo.addEventListener("canplay", tryPlay);

        buildPlayer();
        return;
      }

      console.warn(
        "Cloudflare hero video: hls.js is unsupported here, using native playback.",
      );
    } catch (error) {
      console.warn("Cloudflare hero video failed to load hls.js.", error);
    }

    playNativeHls();
  };

  // The signup form is held back so the hero video plays uninterrupted. It
  // arrives either when the video has run once or when the visitor asks for it
  // by clicking "Stay tuned".
  const initSignupFormReveal = () => {
    const wrapper = document.querySelector("[data-signup-form-wrapper]");
    const triggerWrapper = document.querySelector(
      "[data-signup-trigger-wrapper]",
    );
    const trigger = document.querySelector("[data-signup-trigger]");
    if (!(wrapper instanceof HTMLElement)) {
      return;
    }

    let revealed = false;

    const revealForm = () => {
      if (revealed) {
        return;
      }
      revealed = true;

      if (triggerWrapper instanceof HTMLElement) {
        triggerWrapper.classList.add("hidden");
      }
      if (trigger instanceof HTMLElement) {
        trigger.setAttribute("aria-expanded", "true");
      }

      wrapper.classList.remove("hidden");
      // Force layout while the form is still transparent, otherwise the
      // display change and the opacity change land in the same frame and the
      // fade is skipped.
      void wrapper.offsetHeight;
      wrapper.classList.remove("opacity-0");
    };

    if (trigger instanceof HTMLElement) {
      trigger.addEventListener("click", revealForm);
    }

    const heroVideo = document.querySelector("[data-hero-video]");
    if (!(heroVideo instanceof HTMLVideoElement)) {
      // No video to wait on, so the form has nothing to be held back for.
      revealForm();
      return;
    }

    // A looping video never fires "ended", so the end of the first playthrough
    // is read off the clock. Streamed playback can also jump straight from the
    // last fragment back to 0 without reporting the final tenths, which the
    // wrap-around check below catches.
    let passedHalfway = false;

    const checkPlaybackProgress = () => {
      const { duration, currentTime } = heroVideo;
      if (!Number.isFinite(duration) || duration <= 0) {
        return;
      }

      if (duration - currentTime <= 0.35) {
        revealForm();
        return;
      }

      if (passedHalfway && currentTime < 1) {
        revealForm();
        return;
      }

      if (currentTime > duration / 2) {
        passedHalfway = true;
      }
    };

    heroVideo.addEventListener("timeupdate", checkPlaybackProgress);
    heroVideo.addEventListener("ended", revealForm);

    // Playback that never starts (blocked autoplay, a failed stream) must not
    // strand the visitor with no way to sign up beyond the trigger.
    heroVideo.addEventListener("error", revealForm);
  };

  initHeroVideoReveal();
  initHeroVideoLoop();
  initHeroVideoAudioControl();
  initSignupFormReveal();
  void initCloudflareHeroVideo();

  const RECAPTCHA_SITE_KEY = "6LcviLsrAAAAACjxjvbZp5mhmku9_-DVmPXCDaPd";

  const loadRecaptchaScript = () => {
    if (typeof window === "undefined")
      return Promise.reject(
        new Error("reCAPTCHA can only run in the browser."),
      );

    if ((window as typeof window & { grecaptcha?: unknown }).grecaptcha) {
      return Promise.resolve();
    }

    return new Promise<void>((resolve, reject) => {
      const existingScript = document.querySelector<HTMLScriptElement>(
        'script[src^="https://www.google.com/recaptcha/api.js"]',
      );
      if (existingScript) {
        existingScript.addEventListener("load", () => resolve(), {
          once: true,
        });
        existingScript.addEventListener(
          "error",
          () => reject(new Error("Failed to load reCAPTCHA script.")),
          {
            once: true,
          },
        );
        return;
      }

      const script = document.createElement("script");
      script.src = `https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(RECAPTCHA_SITE_KEY)}`;
      script.async = true;
      script.defer = true;
      script.onload = () => resolve();
      script.onerror = () =>
        reject(new Error("Failed to load reCAPTCHA script."));
      document.head.append(script);
    });
  };

  const getRecaptchaToken = async () => {
    if (!RECAPTCHA_SITE_KEY) {
      throw new Error("Missing reCAPTCHA site key.");
    }

    await loadRecaptchaScript();

    const grecaptcha = (
      window as typeof window & {
        grecaptcha?: {
          ready: (cb: () => void) => void;
          execute: (
            siteKey: string,
            options: { action: string },
          ) => Promise<string>;
        };
      }
    ).grecaptcha;

    if (!grecaptcha) {
      throw new Error("reCAPTCHA is not available on this page.");
    }

    return new Promise<string>((resolve, reject) => {
      grecaptcha.ready(() => {
        grecaptcha
          .execute(RECAPTCHA_SITE_KEY, { action: "contact_form" })
          .then((token: string) => resolve(token))
          .catch((error: unknown) => reject(error));
      });
    });
  };

  const form = document.querySelector("#contact-form");

  if (form instanceof HTMLFormElement) {
    const controls = form.querySelectorAll("input, textarea, select");
    const submitButton = form.querySelector('button[type="submit"]');
    const submitStatus = form.querySelector("[data-submit-status]");
    const endpoint =
      "https://api.clyo.com/umbraco/forms/delivery/api/v1/entries/42911cd0-25e9-40f2-818d-550e6211bbe0";
    let hasAttemptedSubmit = false;

    const setFieldErrorState = (field: Element) => {
      if (
        !(
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement ||
          field instanceof HTMLSelectElement
        )
      ) {
        return;
      }

      const errorTargetName = field.name;
      const errorElement = form.querySelector(
        `[data-error-for="${errorTargetName}"]`,
      );

      if (!hasAttemptedSubmit) {
        field.setAttribute("aria-invalid", "false");
        if (field.type === "checkbox") {
          const checkboxRow = field.closest("[data-checkbox-row]");
          if (checkboxRow) {
            checkboxRow.setAttribute("data-invalid", "false");
          }
        }
        if (errorElement) {
          errorElement.textContent = "";
        }
        return;
      }

      const isInvalid = !field.checkValidity();

      field.setAttribute("aria-invalid", String(isInvalid));

      if (field.type === "checkbox") {
        const checkboxRow = field.closest("[data-checkbox-row]");
        if (checkboxRow) {
          checkboxRow.setAttribute("data-invalid", String(isInvalid));
        }
      }

      if (errorElement) {
        errorElement.textContent = isInvalid ? field.validationMessage : "";
      }
    };

    controls.forEach((field: Element) => {
      setFieldErrorState(field);
      field.addEventListener("blur", () => setFieldErrorState(field));
      field.addEventListener("input", () => setFieldErrorState(field));
      field.addEventListener("change", () => setFieldErrorState(field));
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      hasAttemptedSubmit = true;

      const formData = new FormData(form);
      const payload = {
        ...Object.fromEntries(formData.entries()),
        privacyConsent: formData.has("privacyConsent"),
      };

      // console.log("Holding page form submission", payload);

      controls.forEach((field: Element) => {
        setFieldErrorState(field);
      });

      if (!form.checkValidity()) {
        console.warn("Form has validation errors.");
        const firstInvalid = form.querySelector('[aria-invalid="true"]');
        if (firstInvalid instanceof HTMLElement) {
          firstInvalid.focus();
        }
        return;
      }

      const values = {
        ...payload,
        domainAddress: window.location.hostname,
      };

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      if (submitStatus instanceof HTMLElement) {
        submitStatus.textContent = "Submitting...";
        submitStatus.classList.remove("hidden", "text-[var(--destructive)]");
        submitStatus.classList.add("text-[var(--color-grey)]");
      }

      try {
        const recaptcha = await getRecaptchaToken();

        const body = {
          values: {
            ...values,
            recaptcha,
          },
        };

        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(body),
        });

        if (!response.ok) {
          throw new Error(
            `Form submission failed with status ${response.status}`,
          );
        }

        // console.log("Holding page form submitted", body);

        if (submitStatus instanceof HTMLElement) {
          submitStatus.textContent =
            "You’re signed up. We’ll be in touch soon.";
          submitStatus.classList.remove(
            "text-[var(--destructive)]",
            "text-[var(--color-grey)]",
          );
          submitStatus.classList.add("text-(--color-cloud-white)");
        }

        form.reset();
        hasAttemptedSubmit = false;
        controls.forEach((field: Element) => {
          setFieldErrorState(field);
        });
      } catch (error) {
        console.error("Holding page form submission failed", error);

        if (submitStatus instanceof HTMLElement) {
          submitStatus.textContent =
            "Something went wrong while submitting the form. Please try again.";
          submitStatus.classList.remove("hidden", "text-[var(--color-grey)]");
          submitStatus.classList.add("text-[var(--destructive)]");
        }
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  }
</script>

<style>
  [data-consent-checkbox] {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    display: inline-block;
    cursor: pointer;
    transition: box-shadow 150ms ease;
  }

  [data-consent-checkbox]:checked {
    background-color: var(--color-sky-blue);
  }

  [data-consent-checkbox]:checked::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 1px;
    width: 4px;
    height: 8px;
    border: solid var(--color-cloud-white);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
</style>
